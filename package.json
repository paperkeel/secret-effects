{
	"name": "secret-effects",
	"version": "0.2.1",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=22.19.0"
	},
	"pnpm": {
		"overrides": {
			"@hono/node-server": "1.19.15",
			"esbuild": "0.28.2",
			"hono": "4.13.5",
			"lodash": "4.18.1",
			"valibot": "1.4.2"
		}
	},
	"scripts": {
		"bootstrap:check": "node scripts/check-bootstrap-boundary.mjs",
		"build": "pnpm -r --if-present build",
		"check": "pnpm bootstrap:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"dev": "alchemy dev --stage dev",
		"deploy": "alchemy deploy --stage prod --yes",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"infra:plan": "alchemy plan --stage prod",
		"lint": "oxlint --type-aware .",
		"semark:check": "node scripts/check-semark.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"wrangler:types": "wrangler types --config apps/api/wrangler.jsonc"
	},
	"dependencies": {
		"@noble/curves": "2.0.1",
		"@noble/hashes": "2.0.1",
		"@t3-oss/env-core": "0.13.11",
		"bs58": "6.0.0",
		"cbor-x": "1.6.6",
		"effect": "4.0.0-rc.112",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260827.1",
		"@effect/platform-node": "4.0.0-rc.112",
		"@opentui/core": "0.5.8",
		"@opentui/react": "0.5.8",
		"@types/node": "22.19.21",
		"@types/react": "19.2.14",
		"alchemy": "2.0.0-beta.74",
		"esbuild": "0.28.2",
		"oxfmt": "0.65.0",
		"oxlint": "1.60.0",
		"oxlint-tsgolint": "7.0.2001",
		"react": "19.2.4",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"wrangler": "4.127.0",
		"yaml": "2.9.0"
	}
}

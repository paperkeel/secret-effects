{
	"name": "@paperkeel/secret-effects-client",
	"version": "0.2.0",
	"description": "Type-safe Secret Effects environment loading for Node.js and Cloudflare Workers",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "pnpm run clean && tsc --project tsconfig.build.json && esbuild src/index.ts --bundle --platform=neutral --format=esm --target=es2022 --external:@t3-oss/env-core --external:zod --external:effect/* --external:@noble/curves/* --external:@noble/hashes/* --external:bs58 --external:cbor-x --outfile=dist/index.js",
		"clean": "rm -rf ./dist",
		"prepack": "pnpm run build"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paperkeel/secret-effects.git",
		"directory": "packages/client"
	},
	"homepage": "https://github.com/paperkeel/secret-effects#readme",
	"bugs": {
		"url": "https://github.com/paperkeel/secret-effects/issues"
	},
	"dependencies": {
		"@noble/curves": "2.0.1",
		"@noble/hashes": "2.0.1",
		"@t3-oss/env-core": "0.13.11",
		"bs58": "6.0.0",
		"cbor-x": "1.6.6",
		"effect": "4.0.0-rc.112",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@secret-effects/crypto": "workspace:*",
		"@secret-effects/protocol": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}

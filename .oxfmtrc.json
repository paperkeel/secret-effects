{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": [
		".agents/**",
		".claude/**",
		".alchemy/**",
		".wrangler/**",
		"coverage/**",
		"dist/**",
		"node_modules/**",
		"pnpm-lock.yaml",
		"skills-lock.json"
	],
	"printWidth": 80,
	"semi": true,
	"singleQuote": false,
	"sortPackageJson": false,
	"trailingComma": "all",
	"useTabs": true
}
